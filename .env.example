GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple for web OAuth.
# APPLE_CLIENT_ID is the Apple Services ID used for web sign-in.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

STRIPE_SECRET_KEY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_WEBHOOK_SECRET=

# RevenueCat — powers iOS in-app subscriptions.
# REVENUECAT_SECRET_KEY: the *secret* API key (RevenueCat → Project settings →
#   API keys → "Secret API Keys", starts with "sk_"). NOT the public appl_ key.
#   Used by /api/billing/revenuecat-sync to verify a purchase and set the plan.
# REVENUECAT_WEBHOOK_AUTH: any strong shared secret you choose. Paste the SAME
#   value into RevenueCat → Integrations → Webhooks → Authorization header,
#   and the webhook URL = https://www.rbtgenius.com/api/billing/revenuecat-webhook
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
# Optional restricted RevenueCat v2 key for Owner proceeds/charts. When it is
# absent, the server first tries REVENUECAT_SECRET_KEY. The project id below is
# RBTGenius's RevenueCat project.
REVENUECAT_V2_SECRET_KEY=
REVENUECAT_PROJECT_ID=bfdfc79b

# OpenAI — powers the AI Tutor.
# If OPENAI_API_KEY is unset, the tutor falls back to the rule-based engine.
# OPENAI_TUTOR_MODEL is optional; default is gpt-4o-mini ($0.15/M in, $0.60/M out).
# Other reasonable choices: gpt-5-nano ($0.05/M in, $0.40/M out).
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=

# App Store review / demo account.
# If unset, no bootstrap test account is created.
# Set these in Vercel before submitting to Apple (App Review needs a working demo login).
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
TEST_ACCOUNT_NAME=

# Admin allowlist — comma-separated emails granted the "admin" role on login.
# Powers the Admin → Members panel. If empty, NOBODY can be promoted to admin
# (this silently disabled the admin panel between 2026-05-21 and 2026-07-24).
# Must be set in Vercel, not just here.
ADMIN_EMAILS=

# Admin notifications (Resend). Emails on: new member, new subscription,
# renewal, cancellation/expiration and failed payment — for BOTH Stripe (web)
# and RevenueCat (iOS). Without RESEND_API_KEY nothing is sent, silently.
# ADMIN_NOTIFICATION_EMAIL accepts several addresses separated by commas.
# If omitted, notifications are sent to the addresses in ADMIN_EMAILS.
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
ADMIN_NOTIFICATION_FROM_EMAIL=
